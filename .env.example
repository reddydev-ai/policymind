# --- Required ---
OPENAI_API_KEY=sk-your-key-here

# --- Models (defaults are sensible) ---
CHAT_MODEL=gpt-4o
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072

# --- Qdrant ---
# Leave QDRANT_URL empty to run a local on-disk Qdrant (no server needed).
# For production, point this at a Qdrant Cloud / self-hosted instance.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=policymind

# --- Retrieval tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
DENSE_TOP_K=20
SPARSE_TOP_K=20
RERANK_TOP_N=5
MIN_CONTEXT_SCORE=0.05
